# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# YOUTUBE_API_KEY: Required for YouTube Data API v3 music search & trending feeds.
# Configure this in your environment secrets to enable live YouTube music discovery.
YOUTUBE_API_KEY="MY_YOUTUBE_API_KEY"

# YOUTUBE_API_KEY_2 (optional, up to YOUTUBE_API_KEY_5 or comma-separated YOUTUBE_API_KEYS):
# Backup YouTube Data API v3 key(s). The server automatically switches to the next key
# if the active key reaches its YouTube API quota limit.
YOUTUBE_API_KEY_2=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
