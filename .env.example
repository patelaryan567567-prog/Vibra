# GEMINI_API_KEY: Required for Gemini AI API calls.
# Add as many backup keys as you want: GEMINI_API_KEY_2, GEMINI_API_KEY_3, ... (no limit)
# OR comma-separated keys in GEMINI_API_KEYS. Switches automatically on quota/rate limit.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_API_KEY_2=""

# YOUTUBE_API_KEY: Required for YouTube Data API v3 music search & trending feeds.
# Add as many backup keys as you want: YOUTUBE_API_KEY_2, YOUTUBE_API_KEY_3, ... (no limit)
# OR comma-separated keys in YOUTUBE_API_KEYS. Switches automatically on quota limit.
YOUTUBE_API_KEY="MY_YOUTUBE_API_KEY"
YOUTUBE_API_KEY_2=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
